// Document Tracking & Workflow Automation System
// Data model: departments, users, documents, multi-department routing,
// audit trail, reference number sequencing, and notifications.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REGISTRY_STAFF // uploads/registers incoming documents
  GM // General Manager — always the first stop after registration
  DEPARTMENT_USER // works within an assigned department
  DEPARTMENT_HEAD
  ADMIN // manages departments, users, and sees everything
}

enum DocumentStatus {
  PENDING // registered, not yet opened by any department
  IN_PROGRESS // opened / actively being handled by at least one department
  COMPLETED // all routes marked complete
  ARCHIVED
}

enum RouteStatus {
  PENDING // sitting in this department's inbox, not yet opened
  OPENED
  FORWARDED // forwarded onward — this hop is now historical
  COMPLETED // this hop is where the document's journey ended
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique // short code used in reference numbers, e.g. "IT", "FIN"
  isGmOffice  Boolean  @default(false) // exactly one department should be flagged true — the GM's office, the mandatory first stop
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users           User[]
  documentsCreated Document[]        @relation("DocumentsCreatedByDept")
  routesFrom      DocumentRoute[]    @relation("RouteFromDept")
  routesTo        DocumentRoute[]    @relation("RouteToDept")
  sequences       ReferenceSequence[]

  @@map("departments")
}

model User {
  id           String   @id @default(cuid())
  // Mirrors the Supabase Auth user id (auth.users.id) — Supabase handles
  // credential storage; this table holds app-level profile + role data.
  authId       String   @unique
  fullName     String
  email        String   @unique
  role         Role     @default(DEPARTMENT_USER)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  documentsRegistered Document[]       @relation("RegisteredBy")
  routesAssigned      DocumentRoute[]  @relation("AssignedTo")
  routeActions        RouteAction[]
  notifications       Notification[]
  comments            Comment[]
  reactionsMade       CommentReaction[]
  mentionsMade        CommentMention[]
  documentVersions    DocumentVersion[]
  savedSearches       SavedSearch[]
  analyticsEvents     AnalyticsEvent[]
  appliedTags         DocumentTag[]
  bulkOperations      BulkOperation[]

  @@index([departmentId])
  @@map("users")
}

// One row per calendar year per institution (or per dept, if you want
// per-department numbering) — guarantees gapless, race-safe sequencing
// via a single atomic UPDATE ... RETURNING in the application layer.
model ReferenceSequence {
  id           String      @id @default(cuid())
  year         Int
  departmentId String? // null = institution-wide sequence
  department   Department? @relation(fields: [departmentId], references: [id])
  lastValue    Int         @default(0)

  @@unique([year, departmentId])
  @@map("reference_sequences")
}

model Document {
  id               String         @id @default(cuid())
  referenceNumber  String         @unique // e.g. TAF/IN/2026/001
  senderName       String
  senderOrg        String?
  subject          String
  receivedDate     DateTime
  scannedFilePath  String // path within Supabase Storage bucket
  fileSizeBytes    Int?
  originalFileName String?
  mimeType         String? // detected via magic bytes, not trusted from the client
  status           DocumentStatus @default(PENDING)

  registeredById   String
  registeredBy     User       @relation("RegisteredBy", fields: [registeredById], references: [id])
  originDeptId     String
  originDept       Department @relation("DocumentsCreatedByDept", fields: [originDeptId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  routes            DocumentRoute[]
  auditEvents       AuditEvent[]
  versions          DocumentVersion[]
  comments          Comment[]
  customValues      DocumentCustomValue[]
  workflowInstances DocumentWorkflowInstance[]
  tags              DocumentTag[]
  analyticsEvents   AnalyticsEvent[]

  @@index([status])
  @@index([senderName])
  @@map("documents")
}

// One row per hop in the document's journey: Registry -> GM -> Dept A ->
// Dept B -> ... Exactly one route per document should be "active"
// (status PENDING or OPENED) at any time — that row is the document's
// current location. All earlier rows are historical (FORWARDED/COMPLETED).
model DocumentRoute {
  id         String      @id @default(cuid())
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sequence   Int // 1 = first hop (GM), 2 = second hop, etc.

  fromDeptId String?
  fromDept   Department? @relation("RouteFromDept", fields: [fromDeptId], references: [id])
  toDeptId   String? // optional — a route can target a person with no department (e.g. Registry staff);
                      // department is then just descriptive context via assignedUser's own record, not required
  toDept     Department? @relation("RouteToDept", fields: [toDeptId], references: [id])

  status         RouteStatus @default(PENDING)
  assignedUserId String?
  assignedUser   User?       @relation("AssignedTo", fields: [assignedUserId], references: [id])
  comments       String?

  receivedAt  DateTime  @default(now())
  openedAt    DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  actions       RouteAction[]
  notifications Notification[]
  routeComments Comment[]

  @@unique([documentId, sequence])
  @@index([toDeptId, status])
  @@index([documentId])
  @@map("document_routes")
}

// Granular per-hop history — supports forwarding, comments, completion.
model RouteAction {
  id        String   @id @default(cuid())
  routeId   String
  route     DocumentRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // "OPENED" | "COMMENTED" | "FORWARDED" | "COMPLETED"
  note      String?
  createdAt DateTime @default(now())

  @@map("route_actions")
}

// Top-level, document-wide audit trail (visible to Registry) — separate
// from per-route actions so Registry gets one clean timeline per document.
model AuditEvent {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorName  String
  event      String // e.g. "REGISTERED", "ROUTED_TO_IT", "COMPLETED_BY_FINANCE"
  detail     String?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@map("audit_events")
}

// Collaboration system - Comments on documents and routes
model Comment {
  id        String   @id @default(cuid())
  documentId String
  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  routeId   String? // Optional - if comment is on a specific route/hop
  route     DocumentRoute? @relation(fields: [routeId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  reactions CommentReaction[]
  mentions  CommentMention[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([routeId])
  @@index([authorId])
  @@map("comments")
}

// Enhanced commenting features - Reactions and Mentions
model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  emoji     String   // The emoji used for reaction (e.g., "👍", "❤️", "🎉")
  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji]) // User can only react once with same emoji to a comment
  @@index([commentId])
  @@index([userId])
  @@map("comment_reactions")
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([commentId, userId]) // User can only be mentioned once per comment
  @@index([commentId])
  @@index([userId])
  @@map("comment_mentions")
}

// Update User model to include inverse relations for mentions and reactions

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  routeId   String?
  route     DocumentRoute?      @relation(fields: [routeId], references: [id])
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// Document versioning system
model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNum Int      @default(1) // Version number for this document
  filePath   String   // Path to the file in storage
  fileSizeBytes Int?
  mimeType   String?
  createdById String
  createdBy  User     @relation(fields: [createdById], references: [id])
  createdAt  DateTime @default(now())
  notes      String?  // Optional notes about this version

  @@unique([documentId, versionNum])
  @@index([documentId])
  @@index([createdById])
  @@map("document_versions")
}

// Custom fields system for documents
model CustomField {
  id          String   @id @default(cuid())
  name        String   // Field name (e.g., "Contract Value", "Department Code")
  fieldType   String   // Type: "text", "number", "date", "select", "checkbox"
  options     String?  // JSON string of options for select/checkbox types
  isRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documentCustomValues DocumentCustomValue[]

  @@index([name])
  @@map("custom_fields")
}

model DocumentCustomValue {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  customFieldId String
  customField  CustomField @relation(fields: [customFieldId], references: [id])
  value        String   // Stored as string, parsed based on fieldType
  updatedAt    DateTime @updatedAt

  @@unique([documentId, customFieldId])
  @@index([documentId])
  @@index([customFieldId])
  @@map("document_custom_values")
}

// Workflow flexibility system
model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String   // Name of the workflow (e.g., "Standard Approval", "Invoice Processing")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules       WorkflowRule[]
  instances   DocumentWorkflowInstance[]

  @@index([name])
  @@map("workflow_definitions")
}

model WorkflowRule {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    WorkflowDefinition @relation(fields: [workflowId], references: [id])
  ruleOrder   Int      // Order in which rules are applied
  condition   String   // JSON condition (e.g., "{field: 'subject', operator: 'contains', value: 'invoice'}")
  actionType  String   // Type: "route_to_dept", "route_to_user", "set_priority", "notify"
  actionConfig String? // JSON configuration for the action
  createdAt   DateTime @default(now())

  @@index([workflowId])
  @@index([ruleOrder])
  @@map("workflow_rules")
}

model DocumentWorkflowInstance {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workflowId   String
  workflow     WorkflowDefinition @relation(fields: [workflowId], references: [id])
  currentStep  Int      @default(0) // Current step in the workflow
  status       String   // "active", "completed", "cancelled"
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([documentId])
  @@index([workflowId])
  @@index([status])
  @@map("document_workflow_instances")
}

// Reporting and analytics enhancements
model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String   // Name of the saved search
  query       String   // The search query
  filters     String?  // JSON string of filters (date ranges, status, etc.)
  isPublic    Boolean  @default(false) // Whether this search is visible to others
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([name])
  @@map("saved_searches")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  eventType  String   // Type: "document_registered", "route_opened", "route_completed", etc.
  eventData  String?  // JSON string with additional event data
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
  @@index([createdAt])
  @@map("analytics_events")
}

// User experience enhancements - Tagging system
model Tag {
  id          String   @id @default(cuid())
  name        String   @unique // Tag name (e.g., "Urgent", "Follow-up", "Legal")
  color       String?  // Hex color code for UI display (e.g., "#FF0000")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   DocumentTag[]

  @@index([name])
  @@map("tags")
}

model DocumentTag {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id])
  appliedAt  DateTime @default(now())
  appliedById String
  appliedBy  User     @relation(fields: [appliedById], references: [id])

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
  @@map("document_tags")
}

// Integration and automation enhancements - Webhooks
model Webhook {
  id          String   @id @default(cuid())
  name        String   // Name of the webhook (e.g., "Slack Notification", "ERP Sync")
  url         String   // Target URL for the webhook
  events      String   // JSON array of events to listen for (e.g., '["document.registered", "route.completed"]')
  isActive    Boolean  @default(true)
  secret      String?  // Optional secret for signature verification
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]

  @@index([name])
  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id])
  eventType  String   // Type of event that triggered this delivery
  payload    String   // JSON payload sent to the webhook
  statusCode Int?     // HTTP status code received (null if delivery failed)
  deliveredAt DateTime @default(now())
  attemptedAt DateTime @default(now())

  @@index([webhookId])
  @@index([eventType])
  @@index([deliveredAt])
  @@map("webhook_deliveries")
}

// System-wide bulk operations tracking
model BulkOperation {
  id          String   @id @default(cuid())
  operationType String // Type: "archive", "export", "delete", "tag", etc.
  status      String   @default("pending") // "pending", "processing", "completed", "failed"
  initiatedById String
  initiatedBy User     @relation(fields: [initiatedById], references: [id])
  startedAt   DateTime @default(now())
  completedAt DateTime?
  itemCount   Int      @default(0) // Number of items processed
  successCount Int      @default(0) // Number of successful operations
  failureCount Int      @default(0) // Number of failed operations
  parameters  String?  // JSON string of operation parameters
  errorLog    String?  // JSON string of errors encountered
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([operationType])
  @@index([status])
  @@index([initiatedById])
  @@map("bulk_operations")
}
